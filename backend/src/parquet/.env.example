# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=social_visualizer_db

# AI 모델 (OpenAI) — LLM_API_KEY에 본인 OpenAI 키를 넣는다. 
# 코드에서 os.environ["LLM_API_KEY"]로 접근하므로 이 줄을 지우면 KeyError가 발생한다.
LLM_API_KEY=
MODEL_PROVIDER=openai

# 질의응답 (local_search/global_search)
RAG_CHAT_MODEL=gpt-5.4-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small

# 인덱싱 (extract_graph/community_reports)
INDEXING_CHAT_MODEL=gpt-5.4-mini
INDEXING_EMBEDDING_MODEL=text-embedding-3-small

INDEXING_COMPLETION_MODEL_ID=indexing_chat_model
INDEXING_EMBEDDING_MODEL_ID=indexing_embedding_model
INDEXING_REPORTS_MODEL_ID=indexing_chat_model_reports

# 부가 기능 (질의 분류·첨부파일 요약·분위기 분석 등)
SUB_TASK_CHAT_MODEL=gpt-5.4-mini

# 아바타 이미지 생성 (OpenAI 이미지 API)
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_QUALITY=low
